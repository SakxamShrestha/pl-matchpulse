{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_verifier.py\"",
            "timeout": 10,
            "statusMessage": "Checking Karpathy loop write boundary"
          }
        ]
      }
    ]
  }
}
